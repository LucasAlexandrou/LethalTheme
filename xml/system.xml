<theme>

    <formatVersion>7</formatVersion>

    <view name="system">

            <image name="background" extra="true">
                <path>${bgImage}</path>
                <pos>0 0</pos>
                <size>1 1</size>
            </image>

            <carousel name="systemcarousel">
                <pos>0 0.20</pos>
                <size>1 0.55</size>
                <color>00000000</color>
                <logoScale>1.25</logoScale>
                <logoSize>0.38 0.38</logoSize>
                <maxLogoCount>3</maxLogoCount>
                <defaultTransition>fade</defaultTransition>
            </carousel>

            <image name="logo">
                <path>${consolePath}${system.theme}.png</path>
                <default>./assets/consoles/unknown.png</default>
            </image>

            <text name="system-name-label" extra="true">
                <pos>0.5 0.75</pos>
                <origin>0.5 0</origin>
                <size>0.9 0.04</size>
                <text>{system:fullName}</text>
                <fontPath>./fonts/CalSans.ttf</fontPath>
                <fontSize>0.045</fontSize>
                <alignment>center</alignment>
                <color>${textColor}</color>
            </text>

            <text name="systemInfo">
                <pos>0.5 0.85</pos>
                <origin>0.5 0</origin>
                <size>0.9 0.04</size>
                <fontPath>./fonts/CalSans.ttf</fontPath>
                <fontSize>0.04</fontSize>
                <alignment>center</alignment>
                <color>${textColor}</color>
                <backgroundColor>00000000</backgroundColor>
            </text>

    </view>
</theme>