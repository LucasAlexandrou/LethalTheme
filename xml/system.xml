<theme>

    <formatVersion>7</formatVersion>

    <view name="system">

            <image name="background" extra="true">
                <path>${bgImage}</path>
                <pos>0 0</pos>
                <size>1 1</size>
            </image>

            <carousel name="systemcarousel">
                <pos>0 0.20</pos>
                <size>1 0.36</size>
                <color>00000000</color>
                <logoScale>1.2</logoScale>
                <logoSize>0.3 0.3</logoSize>
                <maxLogoCount>3</maxLogoCount>
            </carousel>

            <image name="logo">
                <path>${consolePath}${system.theme}.png</path>
                <default>./assets/consoles/unknown.png</default>
            </image>

    </view>
</theme>