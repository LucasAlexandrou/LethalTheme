<theme>

    <formatVersion>7</formatVersion>

    <view name="gamecarousel">
		<image name="background" extra="true">
			<path>${bgImage}</path>
			<pos>0 0</pos>
			<size>1 1</size>
		</image>
		
		<gamecarousel name="gamecarousel">
			<pos>0.05 0.1</pos>
			<size>0.9 0.7</size>
			<logoSize>0.55 0.55</logoSize>
			<logoScale>1.6</logoScale>
			<type>horizontal</type>
			<maxLogoCount>3</maxLogoCount>
			<imageSource>image</imageSource>
		</gamecarousel>

		<text name="logoText">
			<pos>0.5 0.05</pos>
			<origin>0.5 0</origin>
			<size>0.7 0.04</size>
			<text>{system:fullName}</text>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<color>${textColor}</color>
			<alignment>center</alignment>
		</text>

		<video name="md_video">
			<pos>0.5 0.45</pos>
			<origin>0.5 0.5</origin>
			<size>0.6 0.6</size>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<snapshotSource>image</snapshotSource>
			<effect>bump</effect>
			<delay>0.7</delay>
		</video>

		<text name="md_name">
			<pos>0.5 0.82</pos>
			<origin>0.5 0</origin>
			<size>0.9 0.04</size>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.045</fontSize>
			<alignment>center</alignment>
			<color>${textColor}</color>
			<displayName>true</displayName>
		</text>

	</view>

</theme>