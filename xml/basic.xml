<theme>

    <formatVersion>7</formatVersion>

    <view name="basic">

		<image name="background">
			<path>${bgImage}</path>
			<pos>0 0</pos>
			<size>1 1</size>
		</image>

		<text name="logoText">
			<pos>0.5 0.1</pos>
			<origin>0.5 0</origin>
			<size>0.9 0.05</size>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.055</fontSize>
			<color>${accentColor}</color>
			<alignment>center</alignment>
		</text>
		
		<textlist name="gamelist">
			<pos>0.05 0.18</pos>
			<size>0.9 0.72</size>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.0425</fontSize>
			<lines>11</lines>
			<selectorColor>00000000</selectorColor>
			<selectedColor>${accentColor}</selectedColor>
			<primaryColor>${textColor}</primaryColor>
			<secondaryColor>${textColor}</secondaryColor>
		</textlist>

	</view>

</theme>