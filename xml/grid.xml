<theme> 

    <formatVersion>7</formatVersion>
    
    <view name="grid">

		<image name="background">
			<path>${bgImage}</path>
			<pos>0 0</pos>
			<size>1 1</size>
		</image>
		
		<imagegrid name="gamegrid">
			<pos>0.03 0.15</pos>
			<size>0.94 0.7</size>
			<margin>0.02 0.02</margin>
			<autoLayout>3 2</autoLayout>
			<autoLayoutZoom>1.15</autoLayoutZoom>
			<imageSource>image</imageSource>
		</imagegrid>

		<text name="grid-system-name" extra="true">
			<pos>0.5 0.05</pos>
			<origin>0.5 0</origin>
			<size>0.7 0.04</size>
			<text>{system:fullName}</text>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<color>${textColor}</color>
			<alignment>center</alignment>
		</text>

		<gridtile name="default">
			<padding>4 4</padding>
			<imageSizeMode>maxSize</imageSizeMode>
			<backgroundColor>${accentColor}30</backgroundColor>
			<backgroundCornerSize>8 8</backgroundCornerSize>
		</gridtile>

		<gridtile name="selected">
			<padding>4 4</padding>
			<imageSizeMode>maxSize</imageSizeMode>
			<backgroundColor>${accentColor}</backgroundColor>
			<backgroundCornerSize>8 8</backgroundCornerSize>
		</gridtile>

		<text name="md_name">
			<pos>0.5 0.88</pos>
			<origin>0.5 0</origin>
			<size>0.9 0.04</size>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.038</fontSize>
			<alignment>center</alignment>
			<color>${textColor}</color>
		</text>

	</view>

</theme>