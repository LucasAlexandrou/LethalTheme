<theme>

	<formatVersion>7</formatVersion>

	<include subset="colorset" name="Light Cyan">./colors/light-cyan.xml</include>
	<include subset="colorset" name="Light Orange">./colors/light-orange.xml</include>
	<include subset="colorset" name="Light Pink">./colors/light-pink.xml</include>
	<include subset="colorset" name="Light Yellow">./colors/light-yellow.xml</include>
	<include subset="colorset" name="Dark Purple">./colors/dark-purple.xml</include>
	<include subset="colorset" name="Dark Green">./colors/dark-green.xml</include>
	<include subset="colorset" name="Dark Cyan">./colors/dark-cyan.xml</include>
	<include subset="colorset" name="Dark Orange">./colors/dark-orange.xml</include>

	<view name="system,grid,gamecarousel,detailed,basic,menu">
		<helpsystem name="help">
			<textColor>${textColor}</textColor>
			<iconColor>${accentColor}</iconColor>
			<fontPath>./fonts/CalSans.ttf</fontPath>
			<fontSize>0.04</fontSize>
		</helpsystem>
	</view>

	<include>./xml/statusbar.xml</include>

	<include>./xml/system.xml</include>

	<include>./xml/basic.xml</include>

	<include>./xml/detailed.xml</include>

	<include>./xml/grid.xml</include>

	<include>./xml/gamecarousel.xml</include>

	<include>./xml/menu.xml</include>

	<include>./xml/screen.xml</include>

</theme>